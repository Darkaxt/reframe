+
+// reframe: like TerminalSetTheme's font part, but with a fractional point size and a cell size. The cell size is
+// kept, so a later TerminalSetTheme keeps it too; empty strings leave the font's own cell width/height.
+void _stdcall TerminalSetFont(void* terminal, LPCWSTR fontFamily, float fontSize, LPCWSTR cellWidth, LPCWSTR cellHeight, int newDpi)
+try
+{
+    const auto publicTerminal = static_cast<HwndTerminal*>(terminal);
+    if (!publicTerminal || !publicTerminal->_terminal)
+    {
+        return;
+    }
+
+    {
+        const auto lock = publicTerminal->_terminal->LockForWriting();
+        publicTerminal->_cellWidth = CSSLengthPercentage::FromString(cellWidth ? cellWidth : L"");
+        publicTerminal->_cellHeight = CSSLengthPercentage::FromString(cellHeight ? cellHeight : L"");
+        publicTerminal->_desiredFont = { fontFamily, 0, DEFAULT_FONT_WEIGHT, fontSize, CP_UTF8 };
+        publicTerminal->_desiredFont.SetEnableBuiltinGlyphs(true);
+        publicTerminal->_desiredFont.SetCellSize(publicTerminal->_cellWidth, publicTerminal->_cellHeight);
+        publicTerminal->_UpdateFont(newDpi);
+    }
+
+    RECT windowRect;
+    GetWindowRect(publicTerminal->_hwnd.get(), &windowRect);
+
+    til::size dimensions;
+    const til::size windowSize{ windowRect.right - windowRect.left, windowRect.bottom - windowRect.top };
+    publicTerminal->Refresh(windowSize, &dimensions);
+}
+CATCH_LOG()
+
+// reframe: ControlCore::Search for the HWND terminal. Every match is highlighted, the current one in the focused
+// highlight, scrolled into view when scrollIntoView is set. Returns the number of matches; currentMatch is the current one's index or -1.
+int _stdcall TerminalSearch(void* terminal, LPCWSTR text, bool goForward, bool caseSensitive, bool executeSearch, bool scrollIntoView, _Out_ int* currentMatch)
+try
+{
+    *currentMatch = -1;
+    const auto publicTerminal = static_cast<HwndTerminal*>(terminal);
+    if (!publicTerminal || !publicTerminal->_terminal)
+    {
+        return 0;
+    }
+
+    const auto lock = publicTerminal->_terminal->LockForWriting();
+    auto& core = *publicTerminal->_terminal;
+    auto& searcher = publicTerminal->_searcher;
+
+    SearchFlag flags{};
+    WI_SetFlagIf(flags, SearchFlag::CaseInsensitive, !caseSensitive);
+    const std::wstring_view needle{ text ? text : L"" };
+
+    const auto searchInvalidated = searcher.IsStale(core, needle, flags);
+    if (searchInvalidated || executeSearch)
+    {
+        std::vector<til::point_span> oldResults;
+        if (searchInvalidated)
+        {
+            oldResults = searcher.ExtractResults();
+            searcher.Reset(core, needle, flags, !goForward);
+            core.SetSearchHighlights(searcher.Results());
+        }
+        if (executeSearch)
+        {
+            searcher.FindNext(!goForward);
+        }
+        core.SetSearchHighlightFocused(gsl::narrow<size_t>(std::max<ptrdiff_t>(0, searcher.CurrentMatch())));
+        publicTerminal->_renderer->TriggerSearchHighlight(oldResults);
+    }
+
+    const auto index = searcher.CurrentMatch();
+    if (index < 0)
+    {
+        return 0;
+    }
+    if (scrollIntoView)
+    {
+        core.ScrollToSearchHighlight(0);
+    }
+    *currentMatch = gsl::narrow<int>(index);
+    return gsl::narrow<int>(searcher.Results().size());
+}
+catch (...)
+{
+    LOG_CAUGHT_EXCEPTION();
+    return 0;
+}
+
+// reframe: ControlCore::ClearSearch without selecting the current match.
+void _stdcall TerminalClearSearch(void* terminal)
+try
+{
+    const auto publicTerminal = static_cast<HwndTerminal*>(terminal);
+    if (!publicTerminal || !publicTerminal->_terminal)
+    {
+        return;
+    }
+
+    const auto lock = publicTerminal->_terminal->LockForWriting();
+    publicTerminal->_terminal->SetSearchHighlights({});
+    publicTerminal->_terminal->SetSearchHighlightFocused(0);
+    publicTerminal->_renderer->TriggerSearchHighlight(publicTerminal->_searcher.Results());
+    publicTerminal->_searcher = {};
+}
+CATCH_LOG()
+
