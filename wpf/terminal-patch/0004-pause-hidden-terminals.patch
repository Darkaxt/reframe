@@ -1118,6 +1118,28 @@ try
 }
 CATCH_LOG()
 
+void _stdcall TerminalSetPainting(void* terminal, bool enable)
+try
+{
+    const auto publicTerminal = static_cast<HwndTerminal*>(terminal);
+    // Nothing for a terminal not created yet, destroyed or torn down (EnablePainting would start its thread again).
+    if (!publicTerminal || !publicTerminal->_terminal || !publicTerminal->_renderEngine || !publicTerminal->_renderer)
+    {
+        return;
+    }
+    if (enable)
+    {
+        // As ControlCore::ResumeRendering: the lock, because it reads the viewport; the whole screen is drawn again.
+        const auto lock = publicTerminal->_terminal->LockForWriting();
+        publicTerminal->_renderer->EnablePainting();
+    }
+    else
+    {
+        publicTerminal->_renderer->DisablePainting();
+    }
+}
+CATCH_LOG()
+
 void __stdcall TerminalSetFocused(void* terminal, bool focused)
 {
     const auto publicTerminal = static_cast<HwndTerminal*>(terminal);
