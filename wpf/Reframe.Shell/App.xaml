<Application x:Class="Reframe.Shell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- reframe's colours and sizes from the Electron UI (checked against styles.css by TokenTests). -->
        <ResourceDictionary Source="Theme/Tokens.xaml" />
        <!-- The Electron UI's controls (buttons, search field, scroll bar, rows, dock and tile), built from the tokens. -->
        <ResourceDictionary Source="Theme/Controls.xaml" />
        <!-- The dialogs' form controls (checkbox, select, text field, links), as Chromium draws them. -->
        <ResourceDictionary Source="Theme/Forms.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
