<Window x:Class="Reframe.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reframe Shell (experimental)" Width="1280" Height="800" MinWidth="640" MinHeight="400"
        Background="{StaticResource bgBrush}" Foreground="{StaticResource textBrush}"
        FontFamily="{StaticResource FontFamily.Ui}" FontSize="{StaticResource FontSize.Base}">
  <!-- Electron's frameless window with a title bar overlay (src/main/windows.ts): the toolbar is the title bar, the
       window buttons sit at its right end. The whole UI (Root) is built in MainWindow.xaml.cs. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="39" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
</Window>
