<Window x:Class="Reframe.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reframe Shell (experimental)" Width="1200" Height="760"
        Background="{StaticResource bgBrush}" Foreground="{StaticResource textBrush}"
        FontFamily="{StaticResource FontFamily.Ui}" FontSize="{StaticResource FontSize.Base}">
  <!-- Colours and sizes from Theme/Tokens.xaml (the Electron UI's); the layout itself is still stage 3a's. -->
  <DockPanel x:Name="Root">
    <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource surfaceBrush}" Foreground="{StaticResource mutedBrush}"
               BorderBrush="{StaticResource borderBrush}" BorderThickness="0,1,0,0" FontSize="{StaticResource FontSize.Small}">
      <TextBlock x:Name="StatusText" />
    </StatusBar>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding Source={StaticResource Sidebar.Width}}" MinWidth="160" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ListBox x:Name="SessionList" Grid.Column="0" Background="{StaticResource surfaceBrush}"
               Foreground="{StaticResource textBrush}" BorderBrush="{StaticResource borderBrush}" BorderThickness="0,0,1,0"
               MouseDoubleClick="SessionList_Open" KeyDown="SessionList_KeyDown">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <!-- Screen readers and UI automation read the session's label, not the item's type name. -->
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="{Binding Source={StaticResource SidebarRow.Padding}}">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Status}" Foreground="{StaticResource mutedBrush}" FontSize="{StaticResource FontSize.Smaller}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource borderBrush}" />
      <TabControl x:Name="Tabs" Grid.Column="2" Background="{StaticResource terminalBrush}" BorderBrush="{StaticResource borderBrush}" />
    </Grid>
  </DockPanel>
</Window>
