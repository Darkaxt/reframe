<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows SDK projection gives the toast API (Toasts.cs) without a package. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- About shows reframe's version: package.json's, without the commit the SDK would append. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\package.json')), '(?&lt;="version":\s*")[^"]+').Value)</InformationalVersion>
    <!-- The release's version as the file version (the managed deploy checks it, as it did reframe.exe's), and
         Electron's icon (shortcuts and the taskbar take it from the executable). -->
    <FileVersion>$(InformationalVersion)</FileVersion>
    <NoWarn>$(NoWarn);CS7035</NoWarn>
    <ApplicationIcon>..\..\build\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE" />
    <!-- The tray icon (TrayIcon.cs), Electron's resources. -->
    <EmbeddedResource Include="..\..\resources\tray.png" LogicalName="tray.png" />
    <EmbeddedResource Include="..\..\resources\tray@2x.png" LogicalName="tray@2x.png" />
  </ItemGroup>
  <ItemGroup>
    <!-- Windows Terminal's WPF control built with reframe's patch (.github/workflows/terminal-wpf.yml); restored from
         packages-local, which wpf/Get-TerminalPackage.ps1 fills after checking the pinned SHA-256. -->
    <PackageReference Include="Reframe.Terminal.Wpf" Version="[1.25.3131-reframe.2]" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Reframe.Shell.Core\Reframe.Shell.Core.csproj" />
  </ItemGroup>
</Project>
