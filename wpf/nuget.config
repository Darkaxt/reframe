<?xml version="1.0" encoding="utf-8"?>
<!-- nuget.org plus the local feed holding the patched terminal control (wpf/Get-TerminalPackage.ps1). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="reframe-local" value="packages-local" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="reframe-local">
      <package pattern="Reframe.Terminal.Wpf" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
