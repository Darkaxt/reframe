{
  "input": {
    "mode": "new",
    "env": {
      "PATH": "C:\\Users\\<user>\\bin;C:\\Program Files\\nodejs",
      "PATHEXT": ".COM;.EXE;.BAT;.CMD",
      "USERPROFILE": "C:\\Users\\<user>",
      "CLAUDECODE": "1",
      "CLAUDE_CODE_SESSION_ID": "<parent-session-id>",
      "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
      "ANTHROPIC_API_KEY": "<api-key>",
      "anthropic_base_url": "https://<gateway>",
      "ANTHROPIC_MODEL": "<model>"
    },
    "claudeHome": "C:\\Users\\<user>\\.claude",
    "settingsDir": "C:\\Users\\<user>\\AppData\\Roaming\\reframe\\hook-settings",
    "hooks": {
      "port": 52100,
      "token": "<hook-token>"
    },
    "captureStatusLine": true,
    "wsl": {
      "share": "\\\\wsl.localhost",
      "command": {
        "file": "C:\\Windows\\System32\\wsl.exe",
        "prefixArgs": [],
        "env": {
          "WSL_UTF8": "1"
        }
      },
      "info": {
        "claude": "/home/<user>/.local/bin/claude",
        "path": "/home/<user>/.local/bin:/usr/bin",
        "claudeHome": "/home/<user>/.claude"
      },
      "homeDir": "C:\\Users\\<user>"
    },
    "session": {
      "id": "s-1",
      "claudeSessionId": "11111111-1111-4111-8111-111111111111",
      "cwd": "\\\\wsl.localhost\\Ubuntu\\home\\<user>\\shop",
      "name": "Shop",
      "launch": {
        "provider": "anthropic",
        "initialPrompt": "hi"
      }
    }
  },
  "fs": {
    "files": {
      "C:\\Users\\<user>\\bin\\claude.exe": ""
    },
    "dirs": [
      "\\\\wsl.localhost\\Ubuntu\\home\\<user>\\shop"
    ],
    "transcripts": []
  }
}
